# Postgres
POSTGRES_DB=my_events
POSTGRES_USER=events_user
POSTGRES_PASSWORD=events_pass

# Spring Datasource (Docker network uses service name `db`)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/my_events
SPRING_DATASOURCE_USERNAME=events_user
SPRING_DATASOURCE_PASSWORD=events_pass
SPRING_PROFILES_ACTIVE=dev

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-64chars
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# Backend
SERVER_PORT=8080

# Frontend
VITE_API_BASE_URL=http://localhost:8080
